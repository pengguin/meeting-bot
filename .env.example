# 飞书开放平台应用
# 需要在飞书开发者后台创建企业自建应用，启用机器人能力和消息事件。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_with_feishu_app_secret

# Hugging Face
# 用于 pyannote 说话人分离模型。需要登录 Hugging Face 并接受模型使用条款。
HF_TOKEN=hf_replace_with_your_token

# 本地语音转写模型
# 调试可用 small；正式中文会议建议 medium。
ASR_MODEL=medium
ASR_LANGUAGE=zh
ASR_CPU_THREADS=16
ASR_BATCH_SIZE=8
ASR_BEAM_SIZE=5

# pyannote 说话人分离模型
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Codex CLI
# 若终端中直接可运行 codex，就写 codex；也可以写绝对路径，如 /opt/homebrew/bin/codex。
CODEX_BIN=codex

# 纪要生成 LLM 后端
# 可选：codex（默认，使用本机 Codex CLI）/ openai（任意 OpenAI 兼容服务，
# 如 OpenAI、DeepSeek、Kimi、通义千问、智谱）/ anthropic / lm-studio / ollama。
LLM_PROVIDER=codex
# API 地址：openai 兼容服务必看。留空时按后端使用默认值：
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com
#   lm-studio -> http://127.0.0.1:1234/v1
#   ollama    -> http://127.0.0.1:11434/v1
LLM_API_BASE=
# API Key：openai / anthropic 必填；本地 lm-studio / ollama 一般留空。
LLM_API_KEY=
# 模型名：openai 兼容服务必填（如 gpt-4o-mini、deepseek-chat）；
# anthropic 留空时默认 claude-sonnet-4-6；lm-studio / ollama 留空时自动选用已加载模型。
LLM_MODEL=
# HTTP 后端单次请求超时（秒）
LLM_TIMEOUT_SECONDS=600

# 可选：指定 ffmpeg 路径。留空时使用 PATH 中的 ffmpeg。
FFMPEG_BIN=ffmpeg

# 可选：本地录音缓存保存位置。留空时默认使用后台支持目录下的 downloads。
RECORDINGS_DIR=

# 可选：会议纪要及相关会议文件保存位置。留空时默认使用后台支持目录下的 sessions。
MEETING_OUTPUT_DIR=

# 可选：报告字体
REPORT_BODY_FONT=PingFang SC
REPORT_HEADING_FONT=PingFang SC
