# 飞书开放平台应用
# 需要在飞书开发者后台创建企业自建应用，启用机器人能力和消息事件。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_with_feishu_app_secret

# Hugging Face
# 用于 pyannote 说话人分离模型。需要登录 Hugging Face 并接受模型使用条款。
HF_TOKEN=hf_replace_with_your_token

# 本地语音转写模型
# 调试可用 small；正式中文会议建议 medium。
ASR_MODEL=medium
ASR_LANGUAGE=zh
ASR_CPU_THREADS=16
ASR_BATCH_SIZE=8
ASR_BEAM_SIZE=5

# pyannote 说话人分离模型
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Codex CLI
# 若终端中直接可运行 codex，就写 codex；也可以写绝对路径，如 /opt/homebrew/bin/codex。
CODEX_BIN=codex

# 可选：指定 ffmpeg 路径。留空时使用 PATH 中的 ffmpeg。
FFMPEG_BIN=ffmpeg

# 可选：本地录音缓存保存位置。留空时默认使用后台支持目录下的 downloads。
RECORDINGS_DIR=

# 可选：会议纪要及相关会议文件保存位置。留空时默认使用后台支持目录下的 sessions。
MEETING_OUTPUT_DIR=

# 可选：报告字体
REPORT_BODY_FONT=PingFang SC
REPORT_HEADING_FONT=PingFang SC
